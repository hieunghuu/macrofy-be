# Postgres container settings (used by docker-compose.yml)
POSTGRES_USER=food_coach
POSTGRES_PASSWORD=food_coach
POSTGRES_DB=food_coach

# App connection string (used by SQLAlchemy/Alembic)
# When Postgres is running via docker-compose, host/port below are correct for local dev.
DATABASE_URL=postgresql+psycopg2://food_coach:food_coach@localhost:5432/food_coach

# --- App metadata ---
APP_NAME=Food Coach API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# --- CORS ---
# Comma-separated list of allowed frontend origins, or "*" for local dev.
# e.g. CORS_ORIGINS=http://localhost:3000,https://app.example.com
CORS_ORIGINS=*

# --- Nutrition/business defaults ---
# Hard floor on any generated calorie target, regardless of goal/rate.
MIN_SAFE_CALORIES=1200
# Grams of protein per kg of bodyweight used when no override is given.
DEFAULT_PROTEIN_G_PER_KG=1.8
# Fraction of daily calories allocated to fat when no override is given.
DEFAULT_FAT_PERCENT=0.25
# Energy density used to convert a weekly weight-change rate into a daily
# calorie surplus/deficit (kcal per kg of body fat).
KCAL_PER_KG_FAT=7700
# Default target rate of weight change (kg/week) when the request omits one.
DEFAULT_RATE_KG_PER_WEEK=0.5
# Default number of meals in a generated plan when the request omits it.
DEFAULT_MEAL_COUNT=3
# Minimum age accepted by the calculator endpoints.
MIN_USER_AGE=18

# --- Future AI service integration ---
# Leave empty to run with AI features disabled (the default). Once the
# separate `ai` repo is built and deployed, set this to its base URL and
# the backend starts using it automatically -- no code changes needed.
AI_SERVICE_URL=
AI_SERVICE_TIMEOUT_SECONDS=5.0
